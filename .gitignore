# dependencies
node_modules/

# env
.env
.env.local
.env.*.local

# next.js
.next/
out/

# build
dist/
build/
tsconfig.tsbuildinfo
next-env.d.ts

# testing
coverage/

# playwright
test-results/
playwright-report/
playwright/.cache/

# logs
*.log
npm-debug.log*

# OS
.DS_Store

# runtime data (keep seeded fixtures, drop generated run traces)
data/traces/*.json
!data/traces/.gitkeep

# per-run screenshot captures (regeneratable; deliberate demo assets live in public/media/)
public/screenshots/

# saved browser sessions (contains live auth cookies)
data/.auth/

# HyperFrames render output (timestamped, regeneratable - canonical copy lives in public/media/)
videos/*/renders/

# HyperFrames internal tooling scratch (TTS staging, review captures) - not read by any composition
videos/*/.media/
videos/*/assets/review/
videos/*/assets/voice/
videos/*/audio_meta.json
videos/*/audio_request.json

# browser session state (contains live login cookies - never commit)
data/.auth/
